# Inject through a secret manager; do not commit real values.
AUTH_ISSUER=
AUTH_AUDIENCE=
# PEM-encoded RSA public verification key, supplied by your identity provider.
AUTH_PUBLIC_KEY=
# Only claims and knowledge need these storage settings.
DATA_ENCRYPTION_KEY=
CLAIMS_DATA_DIR=/data/claims
KNOWLEDGE_DATA_DIR=/data/knowledge
GEMINI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL must be an available model in your approved project/region.
GEMINI_MODEL=
